{
  "name": "@edrithm/landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "npm run check:tokens && next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:tokens && vitest run",
    "check:tokens": "node design-system/tangerine/build.mjs --check && node design-system/tangerine/check.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "check:supply-chain": "node scripts/supply-chain/check-supply-chain.mjs",
    "check:invisible": "node scripts/gates/check-invisible-characters.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx --sbom-type application > sbom.cdx.json",
    "check:installed": "node scripts/supply-chain/check-installed.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.37.0",
    "lucide-react": "^0.575.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
